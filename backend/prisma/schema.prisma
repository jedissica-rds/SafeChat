generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  username            String   @unique
  salt                String
  publicKey           String
  encryptedPrivateKey String
  authKey             String
  createdAt           DateTime @default(now())
}